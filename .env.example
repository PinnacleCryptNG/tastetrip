# Qloo (server-side only; never prefix with NEXT_PUBLIC_)
QLOO_API_KEY=your-qloo-hackathon-key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible endpoint (default: Nebius Token Factory, Nemotron)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=your-llm-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Upstash Redis / Vercel KV (trips + 24h Qloo cache). Without these, an in-memory store is used locally.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-kv-token

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local UI development only, before you have a Qloo key: synthetic "Mock" places. Ignored in production and on Vercel.
# QLOO_MOCK=1
